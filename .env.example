# VASTRAÉ AI Virtual Try-On Studio — Environment Configuration
# Add your API token to enable real-time photorealistic AI Virtual Try-On.
# When an API key is set here, the backend server securely calls the chosen model.
# When no key is set, the studio transparently displays a setup guide modal instead of faking results.

# Option 1: HuggingFace IDM-VTON (Recommended for Virtual Try-On)
# HUGGINGFACE_API_TOKEN=hf_your_huggingface_token_here

# Option 2: Replicate (IDM-VTON)
# REPLICATE_API_TOKEN=r8_your_replicate_token_here

# Option 3: Fal.ai Virtual Try-On
# FAL_KEY=your_fal_key_here

# Option 4: Google Gemini Vision & Synthesis
# GEMINI_API_KEY=your_gemini_api_key_here

# Option 5: OpenAI DALL-E / GPT-Image
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Server Port (default: 8000)
PORT=8000
